# Copy to .env for local development. Never commit real secrets.
ENV=development
LOG_LEVEL=info
PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://dogear:dogear@localhost:5432/dogear?sslmode=disable

# openssl rand -base64 32
SESSION_SECRET=
IP_HASH_SALT=
CONTACT_EMAIL=hello@dogear.fyi
# Proxies that append to X-Forwarded-For in front of the app (Railway: 1).
# 0 ignores the header and rate-limits by socket address.
TRUSTED_PROXY_HOPS=0
# Optional: a random value that a Cloudflare request rule adds as the
# X-Origin-Secret header, proving traffic came through your own zone.
CLOUDFLARE_ORIGIN_SECRET=

# GitHub OAuth app (callback: $BASE_URL/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user id that becomes admin on login
ADMIN_GITHUB_ID=
# Personal access token with no scopes, for the importer's rate limits
GITHUB_TOKEN=

# Google OAuth (callback: $BASE_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (return URL: $BASE_URL/auth/apple/callback; HTTPS only)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# open or invite
SIGNUPS=invite
SAFE_BROWSING_API_KEY=

# jev or noop. noop holds every new post for review.
CLASSIFIER=noop
JEV_API_KEY=
JEV_BASE_URL=

# GitHub App for list-repo sync
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=dogear-sync

# Set to false when a pre-deploy step runs `dogear migrate`
MIGRATE_ON_START=true

# Semantic search (OpenAI embeddings). Empty = keyword search only.
OPENAI_API_KEY=
